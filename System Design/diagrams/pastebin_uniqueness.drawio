<mxfile><diagram name="Uniqueness"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="Where ID uniqueness is enforced" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="0" width="460" height="30" as="geometry"/></mxCell>
<mxCell id="l1" value="① Refill job&lt;br&gt;&lt;small&gt;random 6-char Base62 · Bloom filter pre-check&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="l1n" value="optimisation — avoids adding used IDs" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5A626E;" vertex="1" parent="1"><mxGeometry x="370" y="75" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="l2" value="② ID pool (Redis set)&lt;br&gt;&lt;small&gt;atomic SPOP · batch of 100 per server&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF0E5;strokeColor=#F0B48A;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="l2n" value="optimisation — no two servers pop the same ID" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#5A626E;" vertex="1" parent="1"><mxGeometry x="370" y="185" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="l3" value="③ DynamoDB conditional put&lt;br&gt;&lt;small&gt;attribute_not_exists(paste_id)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="l3n" value="&lt;b&gt;the guarantee&lt;/b&gt; — check + insert in one atomic op" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#1E7F3E;" vertex="1" parent="1"><mxGeometry x="370" y="295" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="ok" value="201 Created" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="retry" value="Collision → new ID, retry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="1"><mxGeometry x="220" y="400" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1E7F3E;fontColor=#1E7F3E;labelBackgroundColor=default;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="l3" target="ok"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="exists" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C9302C;fontColor=#C9302C;labelBackgroundColor=default;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="l3" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n" value="&lt;b&gt;Never check-then-insert&lt;/b&gt;&lt;br&gt;Two separate calls race: both read &quot;free&quot;,&lt;br&gt;both write, one paste is silently overwritten.&lt;br&gt;(check-then-act / TOCTOU)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="450" y="385" width="300" height="80" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
