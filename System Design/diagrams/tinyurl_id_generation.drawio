<mxfile><diagram name="ID Generation"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="ID Generation — Token Ranges" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="0" width="420" height="30" as="geometry"/></mxCell><mxCell id="ctr" value="Counter Service&lt;br&gt;&lt;small&gt;single source of truth · active + standby&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF0E5;strokeColor=#F0B48A;" vertex="1" parent="1"><mxGeometry x="250" y="50" width="240" height="60" as="geometry"/></mxCell><mxCell id="s1" value="API Server 1&lt;br&gt;&lt;small&gt;range 1 – 1,000&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="160" height="60" as="geometry"/></mxCell><mxCell id="s2" value="API Server 2&lt;br&gt;&lt;small&gt;range 1,001 – 2,000&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="290" y="190" width="160" height="60" as="geometry"/></mxCell><mxCell id="s3" value="API Server 3&lt;br&gt;&lt;small&gt;range 2,001 – 3,000&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="540" y="190" width="160" height="60" as="geometry"/></mxCell><mxCell id="b62" value="local counter++ → Base62&lt;br&gt;&lt;small&gt;ID 3,521,614,606,207 → &quot;zzzzzzz&quot; (max 7-char)&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="1"><mxGeometry x="220" y="320" width="300" height="60" as="geometry"/></mxCell><mxCell id="e1" value="allocate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;" edge="1" parent="1" source="ctr" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="allocate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;" edge="1" parent="1" source="ctr" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="allocate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;" edge="1" parent="1" source="ctr" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#8BCB9F;" edge="1" parent="1" source="s2" target="b62"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n" value="&lt;b&gt;Why it works&lt;/b&gt;&lt;br&gt;• Ranges are exclusive → zero collisions&lt;br&gt;• 1,200 writes/s ÷ 1,000 = ~1.2 counter calls/s&lt;br&gt;• Counter down → servers burn local range, standby takes over&lt;br&gt;• Server crash → ≤ 1,000 IDs wasted out of 3.5 trillion" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="160" y="420" width="420" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
