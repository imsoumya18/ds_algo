<mxfile><diagram name="TinyURL Architecture"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="TinyURL — Final Architecture" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="0" width="400" height="30" as="geometry"/></mxCell><mxCell id="client" value="Client&lt;br&gt;&lt;small&gt;Browser / App&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="140" height="60" as="geometry"/></mxCell><mxCell id="lb" value="Load Balancer&lt;br&gt;&lt;small&gt;active-active pair&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="220" y="160" width="140" height="60" as="geometry"/></mxCell><mxCell id="api" value="API Servers&lt;br&gt;&lt;small&gt;stateless · auto-scaling&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="160" height="60" as="geometry"/></mxCell><mxCell id="idgen" value="ID Gen Service&lt;br&gt;&lt;small&gt;token ranges · active+standby&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF0E5;strokeColor=#F0B48A;" vertex="1" parent="1"><mxGeometry x="390" y="40" width="180" height="60" as="geometry"/></mxCell><mxCell id="redis" value="Redis Cluster&lt;br&gt;&lt;small&gt;consistent hashing · LRU&lt;br&gt;primary + replicas&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F3EEFF;strokeColor=#B9A6F0;boundedLbl=1;size=10;" vertex="1" parent="1"><mxGeometry x="620" y="250" width="170" height="90" as="geometry"/></mxCell><mxCell id="ddb" value="DynamoDB&lt;br&gt;&lt;small&gt;PK: short_code · native TTL&lt;br&gt;multi-AZ · read replicas&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F3EEFF;strokeColor=#B9A6F0;boundedLbl=1;size=10;" vertex="1" parent="1"><mxGeometry x="390" y="380" width="180" height="90" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;verticalAlign=bottom;" edge="1" parent="1" source="client" target="lb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;" edge="1" parent="1" source="lb" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="new range&lt;br&gt;1 per 1,000 writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#F0B48A;fontColor=#5A626E;labelBackgroundColor=default;" edge="1" parent="1" source="api" target="idgen"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="① GET /{code}&lt;br&gt;check cache" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;" edge="1" parent="1" source="api" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="② miss → read&lt;br&gt;③ populate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#C9302C;fontColor=#C9302C;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="redis" target="ddb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="POST /urls&lt;br&gt;write mapping" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;" edge="1" parent="1" source="api" target="ddb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid = sync request · dashed red = cache-miss path&lt;br&gt;dashed orange = rare control call (range fetch)&lt;br&gt;Redirect = &lt;b&gt;301&lt;/b&gt; (browser caches it)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;fillColor=#FFF9DB;strokeColor=#E9D58A;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="300" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
